{
  "name": "Dental Receptionist - Appointment Reminder Worker",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "hourly-reminder",
      "name": "Every Hour"
    },
    {
      "parameters": {
        "jsCode": "const from=new Date(Date.now()+23*3600000);\nconst to=new Date(Date.now()+25*3600000);\nreturn [{json:{window_start:from.toISOString(),window_end:to.toISOString()}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "reminder-window",
      "name": "Build 24h Reminder Window"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/dental_appointments?status=in.(CONFIRMED,RESCHEDULED)&reminder_24h_sent_at=is.null&start_time=gte.' + encodeURIComponent($json.window_start) + '&start_time=lt.' + encodeURIComponent($json.window_end) + '&select=*' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        464,
        0
      ],
      "id": "due-reminders",
      "name": "Get Due Appointment Reminders"
    },
    {
      "parameters": {
        "jsCode": "const raw=$json;\nconst rows=Array.isArray(raw)?raw:(Array.isArray(raw.body)?raw.body:[raw]);\nreturn rows.filter(r=>r?.appointment_id).map(r=>({json:r}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        0
      ],
      "id": "split-reminders",
      "name": "Split Due Reminders"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/' + $env.META_GRAPH_API_VERSION + '/' + $env.WHATSAPP_PHONE_NUMBER_ID + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.WHATSAPP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ messaging_product:'whatsapp', to:$json.patient_phone.replace('+',''), type:'template', template:{ name:$env.WHATSAPP_REMINDER_TEMPLATE_NAME, language:{ code:$env.WHATSAPP_TEMPLATE_LANGUAGE || 'en' } } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        944,
        0
      ],
      "id": "send-reminder",
      "name": "Send WhatsApp Reminder"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/dental_appointments?appointment_id=eq.' + encodeURIComponent($('Split Due Reminders').item.json.appointment_id) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ reminder_24h_sent_at:new Date().toISOString(), updated_at:new Date().toISOString() }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1184,
        0
      ],
      "id": "mark-reminder",
      "name": "Mark Reminder Sent"
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Build 24h Reminder Window",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build 24h Reminder Window": {
