    {
      "parameters": {
        "jsCode": "const req=$('Normalize Manage Request').first().json;\nconst raw=$json;\nconst appt=Array.isArray(raw)?raw[0]:(Array.isArray(raw.body)?raw.body[0]:raw);\nif(!appt?.appointment_id) throw new Error('Appointment not found for this patient');\nif(['CANCELLED','COMPLETED','NO_SHOW'].includes(String(appt.status))) throw new Error('Appointment is not active');\nreturn [{json:{...req,appointment:appt}}];"
      },
