    {
      "parameters": {
        "jsCode": "const src=$json.body ?? $json;\nconst action=String(src.action ?? '').toLowerCase();\nif(!['reschedule','cancel'].includes(action)) throw new Error('action must be reschedule or cancel');\nfor(const key of ['clinic_id','patient_phone','appointment_id']){\n  if(!String(src[key] ?? '').trim()) throw new Error(key+' is required');\n}\nif(action==='reschedule' && !String(src.new_start_time ?? '').trim()) throw new Error('new_start_time is required for reschedule');\nreturn [{json:{\n  action,\n  clinic_id:String(src.clinic_id),\n  patient_phone:String(src.patient_phone),\n  appointment_id:String(src.appointment_id),\n  new_start_time:src.new_start_time ? new Date(src.new_start_time).toISOString() : null\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
