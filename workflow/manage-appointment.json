    {
      "parameters": {
        "jsCode": "const base=$('Prepare Management Context').first().json;\nconst ctx=$json;\nconst start=new Date(base.new_start_time);\nconst duration=Number(ctx.service?.duration_minutes ?? 30);\nconst buffer=Number(ctx.service?.buffer_minutes ?? 0);\nconst end=new Date(start.getTime()+duration*60000);\nconst blockedEnd=new Date(end.getTime()+buffer*60000);\nconst conflicts=(Array.isArray(ctx.appointments)?ctx.appointments:[])\n  .filter(a=>a.appointment_id!==base.appointment_id)\n  .some(a=>start<new Date(a.end_time) && blockedEnd>new Date(a.start_time));\nconst closure=(Array.isArray(ctx.closures)?ctx.closures:[])\n  .some(a=>start<new Date(a.ends_at) && blockedEnd>new Date(a.starts_at));\nreturn [{json:{\n  ...base,\n  reschedule_context:ctx,\n  new_end_time:end.toISOString(),\n  new_blocked_end_time:blockedEnd.toISOString(),\n  local_conflict:conflicts||closure\n}}];"
      },
