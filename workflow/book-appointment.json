      "parameters": {
        "jsCode": "const src=$json.body ?? $json;\nfor(const key of ['clinic_id','patient_name','patient_phone','dentist_id','service_id','start_time']){\n  if(!String(src[key] ?? '').trim()) throw new Error(key+' is required');\n}\nconst start=new Date(src.start_time);\nif(Number.isNaN(start.getTime())) throw new Error('start_time must be ISO-8601');\nreturn [{json:{\n  clinic_id:String(src.clinic_id),\n  patient_name:String(src.patient_name).trim(),\n  patient_phone:String(src.patient_phone).trim(),\n  dentist_id:String(src.dentist_id),\n  service_id:String(src.service_id),\n  start_time:start.toISOString(),\n  requested_date:String(src.start_time).slice(0,10),\n  notes:String(src.notes ?? '')\n}}];"
      },
