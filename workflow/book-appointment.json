    {
      "parameters": {
        "jsCode": "const req=$('Normalize Booking Request').first().json;\nconst context=$json;\nif(!context?.clinic || !context?.dentist || !context?.service) throw new Error('Booking configuration not found');\n\nconst start=new Date(req.start_time);\nconst duration=Number(context.service.duration_minutes || 30);\nconst buffer=Number(context.service.buffer_minutes || 0);\nconst end=new Date(start.getTime()+duration*60000);\nconst blockedEnd=new Date(end.getTime()+buffer*60000);\nconst tz=context.clinic.timezone || 'Asia/Kolkata';\nconst schedules=Array.isArray(context.schedule)?context.schedule:[];\nconst closures=Array.isArray(context.closures)?context.closures:[];\nconst appointments=Array.isArray(context.appointments)?context.appointments:[];\n\nfunction zonedDateTimeToUtc(dateStr,timeStr,timeZone){\n  const [y,m,d]=dateStr.split('-').map(Number);\n  const [hh,mm,ss=0]=timeStr.split(':').map(Number);\n  let guess=new Date(Date.UTC(y,m-1,d,hh,mm,ss));\n  const fmt=new Intl.DateTimeFormat('en-US',{timeZone,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'});\n  for(let n=0;n<2;n++){\n    const p=Object.fromEntries(fmt.formatToParts(guess).filter(x=>x.type!=='literal').map(x=>[x.type,x.value]));\n    const represented=Date.UTC(Number(p.year),Number(p.month)-1,Number(p.day),Number(p.hour),Number(p.minute),Number(p.second));\n    const wanted=Date.UTC(y,m-1,d,hh,mm,ss);\n    guess=new Date(guess.getTime()+(wanted-represented));\n  }\n  return guess;\n}\nfunction overlaps(a,b,c,d){return a<d && b>c;}\n\nlet insideSchedule=false;\nfor(const row of schedules){\n  const windowStart=zonedDateTimeToUtc(req.requested_date,String(row.start_time).slice(0,8),tz);\n  const windowEnd=zonedDateTimeToUtc(req.requested_date,String(row.end_time).slice(0,8),tz);\n  if(start>=windowStart && blockedEnd<=windowEnd){insideSchedule=true;break;}\n}\nconst dbBusy=[\n  ...appointments.map(a=>({start:new Date(a.start_time),end:new Date(a.end_time)})),\n  ...closures.map(a=>({start:new Date(a.starts_at),end:new Date(a.ends_at)}))\n];\nconst dbConflict=dbBusy.some(b=>overlaps(start,blockedEnd,b.start,b.end));\n\nconst localParts=Object.fromEntries(new Intl.DateTimeFormat('en-US',{timeZone:tz,hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(start).filter(x=>x.type!=='literal').map(x=>[x.type,x.value]));\nconst interval=Number(context.clinic.slot_interval_minutes || 30);\nconst aligns=Number(localParts.minute)%interval===0;\n\nreturn [{json:{\n  ...req,\n  context,\n  calendar_id:String(context.dentist.google_calendar_id ?? ''),\n  end_time:end.toISOString(),\n  blocked_end_time:blockedEnd.toISOString(),\n  business_rules_ok:insideSchedule && !dbConflict && aligns,\n  rejection_reason:!insideSchedule?'outside_working_hours':dbConflict?'database_conflict':!aligns?'invalid_slot_increment':''\n}}];"
      },
