# Example only. Never commit real credentials.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Calendar credentials are connected through n8n's credential store.
DEMO_GOOGLE_CALENDAR_ID=replace-with-calendar-id

# WhatsApp confirmations/reminders
META_GRAPH_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_REMINDER_TEMPLATE_NAME=your_approved_template
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional voice-provider values used outside the core n8n tool workflows.
SARVAM_API_KEY=your_sarvam_key
ELEVENLABS_API_KEY=your_elevenlabs_key

# Optional human notification endpoint
HUMAN_HANDOFF_WEBHOOK_URL=https://example.com/reception-handoff
